# =============================================================================
# Lab 7 Environment Configuration: API Gateway & Service Discovery
# =============================================================================

# Public Gateway Exposed Host Port (Single Entry Point)
PORT=5000
GATEWAY_PORT=5000

# Service Discovery: Target Microservice Locations
# Inside Docker Network: Use Container/Service Hostnames
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# Internal Service Ports (Non-exposed to host)
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003

# Database Connection URIs (Optional: Cloud MongoDB Atlas URI or Local Mongo)
# For local container:
MONGO_URI=mongodb://mongodb:27017
# For cloud deployment (MongoDB Atlas):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
