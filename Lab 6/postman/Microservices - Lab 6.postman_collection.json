    {
      "name": "8. Order Service - POST Create Order (Order -> User and Product) (Expected 201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 101,\n  \"productId\": 501,\n  \"quantity\": 2\n}"
        },
        "url": {
          "raw": "http://localhost:3003/orders",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3003",
          "path": ["orders"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Total amount correctly calculated\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.userId).to.eql(101);",
              "    pm.expect(jsonData.productId).to.eql(501);",
              "    pm.expect(jsonData.quantity).to.eql(2);",
              "    pm.expect(jsonData.totalAmount).to.eql(99.98);",
              "    pm.expect(jsonData.status).to.eql(\"CONFIRMED\");",
              "});",
              "pm.test(\"Embedded snapshots present\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.userSnapshot.name).to.eql(\"Alice Johnson\");",
              "    pm.expect(jsonData.productSnapshot.name).to.eql(\"Cloud Computing & SOA Textbook\");",
              "});"
            ]
          }
        }
      ]
    },
